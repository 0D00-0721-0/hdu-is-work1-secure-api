# Interim configuration mitigation on the vulnerable 9.0.30 image.
# The application does not need AJP, so the connector is removed.
FROM vulhub/tomcat:9.0.30

RUN sed -i 's|<Connector port="8009" protocol="AJP/1.3" redirectPort="8443" />|<!-- AJP connector disabled for CVE-2020-1938 mitigation -->|' $CATALINA_HOME/conf/server.xml \
    && ! grep -q '<Connector port="8009"' $CATALINA_HOME/conf/server.xml
